##
# Ghidra headless session: a long-lived process that opens a project, lists it, opens and
# switches programs and runs commands and scripts, driven by JSON lines on stdio and/or an
# authenticated loopback socket. See Ghidra/Features/HeadlessSession/README.md.
#
# stdout is the protocol channel: this script must never echo anything to it.

MAXMEM_DEFAULT=2G

GHIDRA_MAXMEM=${GHIDRA_MAXMEM:=${MAXMEM_DEFAULT}}
GHIDRA_HEADLESS_MAXMEM=${GHIDRA_HEADLESS_MAXMEM:=${GHIDRA_MAXMEM}}

VMARG_LIST="-XX:ParallelGCThreads=2 -XX:CICompilerCount=2 -Djava.awt.headless=true"
VMARG_LIST="${VMARG_LIST} ${GHIDRA_JAVA_OPTIONS} ${GHIDRA_HEADLESS_JAVA_OPTIONS}"

LAUNCH_MODE=fg

DEBUG_ADDRESS=127.0.0.1:13003

SCRIPT_FILE="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="${SCRIPT_FILE%/*}"

DEBUG_ADDRESS=${DEBUG_ADDRESS} "${SCRIPT_DIR}"/launch.sh "${LAUNCH_MODE}" jdk Ghidra-HeadlessSession "${GHIDRA_HEADLESS_MAXMEM}" "${VMARG_LIST}" ghidra.app.util.headless.session.HeadlessSession "$@"
